{
  "name": "@percy/ember",
  "version": "5.0.3-beta.0",
  "description": "Ember client library for visual testing with Percy",
  "keywords": [
    "ember-addon",
    "percy",
    "visual testing"
  ],
  "repository": "https://github.com/percy/ember-percy",
  "license": "MIT",
  "author": "Perceptual Inc.",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "types"
  ],
  "engines": {
    "node": ">= 16"
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "build": "rollup --config",
    "lint": "echo \"TODO\"",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "echo \"TODO\""
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@embroider/addon-shim": "^1.11.0",
    "@percy/sdk-utils": "^1.32.12"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/runtime": "^8.1.2",
    "@ember/test-helpers": "^5.8.0",
    "@embroider/addon-dev": "^8.5.0",
    "@percy/cli": "^1.32.12",
    "@rollup/plugin-babel": "^7.1.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "ember-source": "~7.4.0",
    "rollup": "^4.68.5"
  },
  "peerDependencies": {
    "@ember/test-helpers": "^5.0.0"
  }
}
